  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- ITALY — skyitalia.it                                      -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <channel site="skyitalia.it" site_id="sky-sport-uno" lang="it" xmltv_id="SkySportUno.it@HD">Sky Sport Uno IT</channel>
