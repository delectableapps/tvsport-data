# epg_channels.xml
# ==================
# Custom channels list for iptv-org/epg grab tool.
# Run with: npm run grab --- --channels epg_channels.xml --output guide.xml
#
# Site coverage for TVsport:
#   sky.com          → UK: TNT Sports 1-4, Sky Sports (all), BBC Sport
#   beinsports.com   → MENA: beIN Sports HD 1-5
#   canalplus.com    → France + beIN Sports 1-3 France
#   supersport.com   → Africa: SuperSport EPL, Football, Variety
#   foxsports.com.au → Australia: Fox Sports (backup for Stan Sport)
#   stan.com.au      → Australia: Stan Sport (if available)
#   viaplay.com      → Nordic/NL (if site added to iptv-org)
#   astro.com.my     → Malaysia: Astro SuperSport 2/3
#
# xmltv_id format: ChannelName.country@variant
# These IDs are used by our XMLTV parser to identify the channel.

<channels>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- UNITED KINGDOM — sky.com                                   -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <!-- TNT Sports -->
  <channel site="sky.com" site_id="3661" lang="en" xmltv_id="TNTSports1.uk@SD">TNT Sports 1</channel>
  <channel site="sky.com" site_id="3663" lang="en" xmltv_id="TNTSports2.uk@SD">TNT Sports 2</channel>
  <channel site="sky.com" site_id="3141" lang="en" xmltv_id="TNTSports4.uk@SD">TNT Sports 4</channel>

  <!-- Sky Sports -->
  <channel site="sky.com" site_id="506"  lang="en" xmltv_id="SkySportsMainEvent.uk@SD">Sky Sports Main Event</channel>
  <channel site="sky.com" site_id="507"  lang="en" xmltv_id="SkySportsPremierLeague.uk@SD">Sky Sports Premier League</channel>
  <channel site="sky.com" site_id="508"  lang="en" xmltv_id="SkySportsFootball.uk@SD">Sky Sports Football</channel>
  <channel site="sky.com" site_id="509"  lang="en" xmltv_id="SkySportsAction.uk@SD">Sky Sports Action</channel>
  <channel site="sky.com" site_id="510"  lang="en" xmltv_id="SkySports4K.uk@UHD">Sky Sports Ultra HDR</channel>

  <!-- BBC Sport (highlights) -->
  <channel site="sky.com" site_id="101"  lang="en" xmltv_id="BBCOne.uk@SD">BBC One</channel>
  <channel site="sky.com" site_id="108"  lang="en" xmltv_id="BBCTwo.uk@SD">BBC Two</channel>


  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- MIDDLE EAST & NORTH AFRICA — beinsports.com               -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <channel site="beinsports.com" site_id="bein-sports-1"  lang="en" xmltv_id="beINSports1.qa@MENA">beIN Sports HD 1</channel>
  <channel site="beinsports.com" site_id="bein-sports-2"  lang="en" xmltv_id="beINSports2.qa@MENA">beIN Sports HD 2</channel>
  <channel site="beinsports.com" site_id="bein-sports-3"  lang="en" xmltv_id="beINSports3.qa@MENA">beIN Sports HD 3</channel>
  <channel site="beinsports.com" site_id="bein-sports-4"  lang="en" xmltv_id="beINSports4.qa@MENA">beIN Sports HD 4</channel>
  <channel site="beinsports.com" site_id="bein-sports-5"  lang="en" xmltv_id="beINSports5.qa@MENA">beIN Sports HD 5</channel>


  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FRANCE — canalplus.com (includes beIN France)             -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <channel site="canalplus.com" site_id="#381" lang="fr" xmltv_id="beINSports1.qa@France">beIN Sports 1 (France)</channel>
  <channel site="canalplus.com" site_id="#384" lang="fr" xmltv_id="beINSports2.qa@France">beIN Sports 2 (France)</channel>
  <channel site="canalplus.com" site_id="#516" lang="fr" xmltv_id="beINSports3.qa@France">beIN Sports 3 (France)</channel>
  <channel site="canalplus.com" site_id="#340" lang="fr" xmltv_id="CanalPlusSport.fr@SD">Canal+ Sport</channel>
